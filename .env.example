# Local on the DB host: unix socket, no password needed
SKEIN_DB_URL=postgresql:///knowledge
# From another machine on the tailnet (after running scripts/setup-tailnet-db.sh on the host):
# SKEIN_DB_URL=postgresql://USER:PASSWORD@HOST/knowledge
SKEIN_OLLAMA_URL=http://localhost:11434
SKEIN_EMBED_MODEL=nomic-embed-text
SKEIN_CHAT_MODEL=llama3.2:3b

# Edge construction
SKEIN_EDGE_TOP_K=6
SKEIN_EDGE_MIN_SIM=0.55
SKEIN_PREDICATE_WINDOW=120

# Predicate vocabulary (comma-separated; defaults baked in if unset)
# SKEIN_PREDICATES=wields,son_of,daughter_of,…
